# Portal PROD Caddyfile
{
	email user@email.com
	debug
}

# Force HTTP to HTTPS for main domains
http://persistica.io, http://portal.persistica.io {
	redir https://{host}{uri} permanent
}

portal.persistica.io,
persistica.io {
	encode gzip

	# Internal, self-hosted mesh (live dashboard counts + data usage), served
	# SAME-ORIGIN so the SDK's /auth/network-client fetch needs no CORS.
	# handle_path strips the /internal-mesh prefix so the mesh server, which
	# expects requests at its root (WS upgrade at "/", auth at "/auth/*"),
	# receives them unprefixed. The mesh port is never published externally.
	# Caddy upgrades WebSocket connections automatically.
	handle_path /internal-mesh* {
		reverse_proxy portal-api-prod:5101
	}

	handle /api* {
		reverse_proxy portal-api-prod:3000
	}

	handle /cddy {
		respond "Caddytime!"
	}

	handle {
		reverse_proxy portal-ui-prod:3001
	}
}
