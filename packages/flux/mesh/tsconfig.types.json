{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../dist",
        "strict": true,
        "declaration": true,
        "target": "ESNext",
        "module": "EsNext",
        "moduleResolution": "bundler",
        "emitDeclarationOnly": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ]
}
