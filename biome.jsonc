{
	"$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": []
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab",
		"expand": "always"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useConst": "off",
				"noInferrableTypes": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
            "suspicious":{
                "noExplicitAny": "warn"
            } 
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	}
}