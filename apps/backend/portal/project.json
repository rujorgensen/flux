{
    "name": "backend-portal",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/backend/src",
    "projectType": "application",
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "bun run --watch {projectRoot}/src/main.ts --tsconfig-override=tsconfig.app.json",
                    "bunx open-cli http://localhost:9000/api/docs"
                ],
                "parallel": true
            },
            "dependsOn": [
                "docker-dev"
            ],
            "continuous": true
        },
        "serve-static": {
            "executor": "nx:run-script",
            "options": {
                "script": "bunx run ../../../dist/apps/frontend/portal/server/entry.mjs"
            }
        },
        "bun-test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun test {projectRoot}/ --env-file=.env.test"
            }
        },
        "docker-dev": {
            "command": "docker compose -p flux-dev -f '.deploy/docker-compose.dev.yml' up -d --build"
        }
    },
    "tags": [
        "scope:portal"
    ]
}