import Login from '../../components/svelte/Login.svelte';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<main>
			<section>
				<Login />
			</section>
		</main>
		<Footer />
	</body>
</html>
