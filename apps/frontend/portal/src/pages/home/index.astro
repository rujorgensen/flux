---
import { ApiCallComponent } from "../../components/angular/api-call/api-call.component";
import { AccordionComponent } from "../../components/angular/accordion/accordion.component";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <ApiCallComponent client:load />
        <AccordionComponent client:load />
      
        <Footer />
    </body>
</html>
