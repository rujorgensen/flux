---
import MeltUI from '../components/svelte/melt-ui/MeltUI.svelte';

// Utilities
import { formatDate } from '../utils/pipes/data-format.pipe';

// Dahsboard tiles
import ConnectedAuthorities from '../components/dashboard/ConnectedAuthorities.svelte';
import ConnectedAgents from '../components/dashboard/ConnectedAgents.svelte';
import ActiveChanels from '../components/dashboard/ActiveChannels.svelte';
import TotalDataUsage from '../components/dashboard/TotalDataUsage.svelte';

import ChartJS from '../components/svelte/ChartJS.svelte';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.svelte';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Pane from '../layouts/dashboard/Pane.astro';
import { app } from '../data/api';

import { readConnectedAuthorityCount } from '../data/api/connected-authorities.service.fn';
import { readChannelCount } from '../data/api/channels.service.fn';
import { readConnectedAgentCount } from '../data/api/connected-agents.service.fn';
import { readTotalNetworkDataUsage } from '../data/api/data-usage.service';
import { readNetworkConfiguration } from '../data/api/read-network-configuration.service';
import { getFluxNetworkConnection } from '../data/flux-connection.fn';
import type { FluxAgentNetworkConnection } from '@flux/shared/connection';
import type { TNetworkId_S } from '@flux/shared/types';

const networkId: string = 'rAnD0M-network-id-from-astro';

const initialConnectedAuthoritiesCount = await readConnectedAuthorityCount(networkId);
const initialChannelCount = await readChannelCount(networkId);
const initialConnectedAgentsCount = await readConnectedAgentCount(networkId);
const initialTotalDataUsage = await readTotalNetworkDataUsage(networkId);
const initialNetworkConofiguration = await readNetworkConfiguration(networkId);

const { data: initialValue } = await app.api['connected-authorities'].get();

let fluxAgentNetworkConnection: FluxAgentNetworkConnection | undefined;
const CODE_TO_ACCESS_NETWORK: string = 'code-to-access-network'; // Key to connect to a network, unknown and irelevant to flux

try {
    fluxAgentNetworkConnection = await getFluxNetworkConnection(networkId as TNetworkId_S, CODE_TO_ACCESS_NETWORK, 'portal-agent');
} catch (error) {
    console.error('Error connecting agent to network:', error);
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            #main-layout {
                display: grid;
                grid-template-columns: auto 1fr;
                grid-template-rows: 100vh;
                grid-template-areas: 'menu main';
                background-color: linear-gradient(var(--gray-gradient)) no-repeat;
            }

            nav {
                grid-area: menu;
                background-color: var(--surface-1);
            }

            #main {
                grid-area: main;
                width: 100%;
                overflow: scroll;
                padding: 100px;
            }

            #grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                grid-template-rows: max-content 400px 800px;

                grid-template-areas:
                    'a b c d ctrl'
                    'table table table table ctrl'
                    'chart chart chart chart ctrl';

                gap: 40px;
            }
        </style>
    </head>

    <body id="main-layout">
        <Toast client:load />

        <nav>
            <Menu client:load />
        </nav>

        <main id="main">
            <main id="grid">
                <Pane id="connected-authorities" area="a">
                    <h2 slot="header">Connected Authorities</h2>
                    <ConnectedAuthorities client:load initial={initialConnectedAuthoritiesCount} />
                </Pane>

                <Pane area="b">
                    <h2 slot="header">Connected Agents</h2>
                    <ConnectedAgents client:load networkId={networkId} fluxAgentNetworkConnection={fluxAgentNetworkConnection} initial={initialConnectedAgentsCount} />
                </Pane>

                <Pane area="chart" area="c">
                    <h2 slot="header">Active Channels</h2>
                    <ActiveChanels client:load networkId={networkId} initial={initialChannelCount} />
                </Pane>

                <Pane area="d">
                    <h2 slot="header">Total Data Usage This Period</h2>
                    <TotalDataUsage client:load networkId={networkId} initial={initialTotalDataUsage} />
                </Pane>
                <Pane class="flair" area="table" style="border: 3px solid #ab00e9; background-color: #f8e8fe;">
                    <h2 slot="header">Table</h2>
                    <ConnectedAgentsHistory client:load networkId={networkId} />
                </Pane>
                <Pane area="chart">
                    <h2 slot="header">Agents</h2>
                    <ChartJS client:load />
                </Pane>
                <Pane area="ctrl">
                    <h2 slot="header">Control Panel</h2>

                    <div class="grid _2xn_auto">
                        <label for="alias">Alias</label>
                        <p id="alias">{initialNetworkConofiguration.alias}</p>
                    </div>
                    <div class="grid _2xn_auto">
                        <label for="network-id">Network ID</label>
                        <p id="network-id">
                            {initialNetworkConofiguration.networkId}
                        </p>
                    </div>
                    <div class="grid _2xn_auto">
                        <label for="total-capacity">Monthly Capacity</label>
                        <p id="total-capacity">
                            {initialNetworkConofiguration.totalCapacity} mb
                        </p>
                        <label for="total-capacity"></label>
                        <p id="total-capacity">
                            Channel Cache: {initialNetworkConofiguration.totalCapacity} mb
                        </p>
                    </div>
                    <div class="grid _2xn_auto">
                        <label for="member-since">Member Since</label>
                        <p id="member-since">
                            {formatDate(initialNetworkConofiguration.memberSince)}
                        </p>
                    </div>
                    <div class="grid _2xn_auto">
                        <label for="access-key">Access Key</label>
                        <button>
                            <p id="access-key">Click to reveal</p>
                        </button>
                        <!-- <p id="access-key">Click to generate new</p> -->
                    </div>
                </Pane>
            </main>

            <MeltUI client:load />
            <Footer />
        </main>
    </body>
</html>
