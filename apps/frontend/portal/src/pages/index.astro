---
import MeltUI from "../components/svelte/melt-ui/MeltUI.svelte";

// * Dahsboard tiles
import ConnectedAuthoritityCount from "../components/dashboard/ConnectedAuthoritityCount.svelte";
import ConnectedAgentCount from "../components/dashboard/ConnectedAgentCount.svelte";
import ActiveChannelCount from "../components/dashboard/ActiveChannelCount.svelte";
import TotalDataUsage from "../components/dashboard/TotalDataUsage.svelte";

// * Dashboard Tables
import ActiveChannels from "../components/dashboard/tables/ActiveChannels.svelte";
import ConnectedAgents from "../components/dashboard/tables/ConnectedAgents.svelte";
import ConnectedAuthorities from "../components/dashboard/tables/ConnectedAuthorities.svelte";

import ChartJS from "../components/svelte/ChartJS.svelte";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.svelte";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Pane from "../layouts/dashboard/Pane.astro";

import { readConnectedAgentCount } from "../data/api/connected-agents.service.fn";
import { readChannelCount } from "../data/api/channels.service.fn";
import { readConnectedAuthoritiesCount } from "../data/api/connected-authorities.service.fn";

const networkId: string = "rAnD0M-demo-network-id";
const CODE_TO_ACCESS_NETWORK: string = "code-to-access-network"; // Key to connect to a network, unknown and irelevant to flux

const initialConnectedAuthoritiesCount =
    await readConnectedAuthoritiesCount(networkId);
const initialConnectedAgentsCount = await readConnectedAgentCount(networkId);
const initialChannelCount = await readChannelCount(networkId);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            #main-layout {
                display: grid;
                grid-template-columns: auto 1fr;
                grid-template-rows: 100vh;
                grid-template-areas: "menu main";
                background-color: linear-gradient(var(--gray-gradient))
                    no-repeat;
            }

            nav {
                grid-area: menu;
                background-color: var(--surface-1);
            }

            #main {
                grid-area: main;
                width: 100%;
                overflow: scroll;
                padding: 100px;
            }

            #grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                grid-template-rows: max-content 400px 800px;

                grid-template-areas:
                    "a b c d ctrl"
                    "table-1 table-1 table-1 table-1 ctrl"
                    "table-2 table-2 table-2 table-2 ctrl"
                    "table table table table ctrl"
                    "chart chart chart chart ctrl";

                gap: 40px;
            }

            /* Basic table styling */
            table {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
                font-size: 18px;
                text-align: left;
            }

            /* Table header styling */
            th {
                background-color: #b663d4;
                color: white;
                padding: 12px;
            }

            /* Table data cell styling */
            td {
                padding: 12px;
                border: 1px solid #ddd;
            }

            /* Alternating row colors */
            tr:nth-child(even) {
                background-color: #f2f2f2;
            }

            /* Hover effect on rows */
            tr:hover {
                background-color: #ddd;
            }

            /* Responsive design */
            @media (max-width: 600px) {
                table,
                th,
                td {
                    display: block;
                    width: 100%;
                }

                th,
                td {
                    text-align: right;
                    padding-left: 50%;
                    position: relative;
                }

                th::before,
                td::before {
                    content: attr(data-label);
                    position: absolute;
                    left: 0;
                    width: 50%;
                    padding-left: 15px;
                    font-weight: bold;
                    text-align: left;
                }
            }
        </style>
    </head>

    <body id="main-layout">
        <nav>
            <Menu client:load />
        </nav>

        <main id="main">
            <main id="grid">
                <Pane id="connected-authorities" area="a">
                    <h2 slot="header">Connected Authorities</h2>
                    <ConnectedAuthoritityCount
                        client:load
                        networkId={networkId}
                        networkCode={CODE_TO_ACCESS_NETWORK}
                        initial={initialConnectedAuthoritiesCount}
                    />
                </Pane>

                <Pane area="b">
                    <h2 slot="header">Connected Agents</h2>
                    <ConnectedAgentCount
                        client:load
                        networkId={networkId}
                        networkCode={CODE_TO_ACCESS_NETWORK}
                        initial={initialConnectedAgentsCount}
                    />
                </Pane>

                <Pane area="chart" area="c">
                    <h2 slot="header">Active Channels</h2>
                    <ActiveChannelCount
                        client:load
                        networkId={networkId}
                        networkCode={CODE_TO_ACCESS_NETWORK}
                        initial={initialChannelCount}
                    />
                </Pane>

                <Pane area="d">
                    <h2 slot="header">Total Data Usage</h2>
                    <TotalDataUsage client:load />
                </Pane>
                <Pane class="flair" area="table-1">
                    <h2 slot="header">Connected Agents</h2>
                    <ConnectedAgents client:load networkId={networkId} />
                </Pane>
                <Pane class="flair" area="table-2">
                    <h2 slot="header">Connected Authorities</h2>
                    <ConnectedAuthorities client:load networkId={networkId} />
                </Pane>
                <Pane class="flair" area="table">
                    <h2 slot="header">Active Channels</h2>
                    <ActiveChannels client:load networkId={networkId} />
                </Pane>
                <Pane area="chart">
                    <h2 slot="header">Agents</h2>
                    <ChartJS client:load />
                </Pane>
                <Pane area="ctrl">
                    <h2 slot="header">Control Panel</h2>
                    <p>dasd</p>
                </Pane>
            </main>

            <MeltUI client:load />
            <Footer />
        </main>
    </body>
</html>
