---
import MeltUI from "../components/svelte/melt-ui/MeltUI.svelte";

// Dahsboard tiles
import ConnectedAuthorities from "../components/dashboard/ConnectedAuthorities.svelte";
import ConnectedAgents from "../components/dashboard/ConnectedAgents.svelte";
import ActiveChanels from "../components/dashboard/ActiveChannels.svelte";
import TotalDataUsage from "../components/dashboard/TotalDataUsage.svelte";

import ChartJS from "../components/svelte/ChartJS.svelte";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.svelte";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Pane from "../layouts/dashboard/Pane.astro";


import { treaty } from '@elysiajs/eden'
import type {
  App
} from '../../../../backend/portal/src/main'
const app = treaty<App>('localhost:3000')

const { data: initialValue } = await app.api['connected-authorities'].get();

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			#main-layout {
				display: grid;
				grid-template-columns: auto 1fr;
				grid-template-rows: 100vh;
				grid-template-areas: "menu main";
				background: linear-gradient(var(--gray-gradient)) no-repeat;
			}

			nav {
				grid-area: menu;
				background-color: var(--surface-1);
			}

			#main {
				grid-area: main;
				width: 100%;
				overflow: scroll;
				padding: 100px;
			}

			#grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				grid-template-rows: max-content 800px;

				grid-template-areas:
					"a b c d ctrl"
					"chart chart chart chart ctrl";

				gap: 40px;
			}
		</style>
	</head>

	<body id="main-layout">
		<nav>
			<Menu client:load />
		</nav>

		<main id="main">
			<main id="grid">
				<Pane id="connected-authorities" area="a">
					<h2 slot="header">Connected Authotities</h2>
					<ConnectedAuthorities initialData={initialValue} client:load />
				</Pane>
				
				<Pane  area="b">
					<h2 slot="header">Connected Agents</h2>
					<ConnectedAgents client:load />
				</Pane>
				
				<Pane  area="chart" area="c">
					<h2 slot="header">Active Channels</h2>
					<ActiveChanels client:load />
				</Pane>
				
				<Pane  area="d">
					<h2 slot="header">Total Data Usage</h2>
					<TotalDataUsage client:load />
				</Pane>
				<Pane area="chart">
					<h2 slot="header">Agents</h2>
					<ChartJS client:load />
				</Pane>
				<Pane area="ctrl">
					<h2 slot="header">Control Panel</h2>
					<p>dasd</p>
				</Pane>
			</main>

			<MeltUI client:load />
			<Footer />
		</main>
	</body>
</html>
