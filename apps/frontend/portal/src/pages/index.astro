---
import BaseHead from "$lib/components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "$lib/consts";
import { HelloComponent } from '../components/angular/hello/hello.component';

import { auth } from "@backend/portal/auth";
import DashboardLayout from "$lib/layouts/dashboard/DashboardLayout.astro";
import Dashboard from "$lib/components/svelte/Dashboard.svelte";

// * Data fetching functions
import { readConnectedAgentCount } from "$lib/data/api/connected-agents.service.fn";
import { readChannelCount } from "$lib/data/api/channels.service.fn";
import { readConnectedAuthoritiesCount } from "$lib/data/api/connected-authorities.service.fn";

const networkId: string = "rAnD0M-demo-network-id";
const networkCode: string = "code-to-access-network"; // Key to connect to a network, unknown and irelevant to flux

const session = await auth.api.getSession({
    headers: Astro.request.headers,
});

if (!session) {
    return Astro.redirect("/sign-in");
}

const initialConnectedAuthoritiesCount =
    await readConnectedAuthoritiesCount(networkId);
const initialConnectedAgentsCount = await readConnectedAgentCount(networkId);
const initialChannelCount = await readChannelCount(networkId);

const helpText = "Helping binding from parent";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <DashboardLayout>
            <!-- 
                <HelloComponent client:visible data-analog-id="hello-component-1" helpText={helpText} />
             -->
            <Dashboard
                client:load
                {networkId}
                {networkCode}
                {initialConnectedAuthoritiesCount}
                {initialConnectedAgentsCount}
                {initialChannelCount}
            />
        </DashboardLayout>
    </body>
</html>

<script>
  import { addOutputListener } from '@analogjs/astro-angular/utils';

  addOutputListener('hello-component-1', 'outputName', (event) => {
    console.log(event.detail);
  });
</script>
