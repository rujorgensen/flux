---
import BaseHead from "$lib/components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "$lib/consts";
import { DashboardHomePageComponent } from "../components/angular/pages/dashboard-home/dashboard-home-page.component";

import { auth } from "@backend/portal/auth";

const networkId: string = "rAnD0M-demo-network-id";
const networkCode: string = "code-to-access-network"; // Key to connect to a network, unknown and irelevant to flux

const session = await auth.api.getSession({
    headers: Astro.request.headers,
});

if (!session) {
    return Astro.redirect("/sign-in");
}

const userSession = session.user;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <DashboardHomePageComponent
            client:load
            networkId={networkId}
            networkCode={networkCode}
            userSession={userSession}
            activeNetworkName="Acme Inc"
        />
    </body>
</html>
