---
import BaseHead from "$lib/components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "$lib/consts";
import { StatsComponent } from "../components/angular/stats/stats.component";
import { ChartComponent } from "../components/angular/chart/chart.component";
import { DashboardComponent } from "../components/angular/dashboard/dashboard.component";

import { auth } from "@backend/portal/auth";
import DashboardLayout from "$lib/layouts/dashboard/DashboardLayout.astro";

const networkId: string = "rAnD0M-demo-network-id";
const networkCode: string = "code-to-access-network"; // Key to connect to a network, unknown and irelevant to flux

const session = await auth.api.getSession({
    headers: Astro.request.headers,
});

if (!session) {
    return Astro.redirect("/sign-in");
}

---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <DashboardLayout>
            <StatsComponent
                client:visible
                data-analog-id="hello-component-1"
                networkId={networkId}
                networkCode={networkCode}
            />

            <DashboardComponent client:load>
                <div class="panel bg-muted/50 max-h-[50vh] flex-1 rounded-xl md:min-h-min">
                    <h2>Agents</h2>
                    <ChartComponent
                        client:visible
                        data-analog-id="chart-component-1"
                    />
                </div>
            </DashboardComponent>
        </DashboardLayout>
    </body>
</html>

<style>
    .panel {
        border-radius: var(--roundness-medium);
        border: 1px solid var(--outline-1);
        background: var(--surface-1);
        box-shadow: var(--shadow-2);
        color: var(--text-1);
        display: grid;

        grid-template-rows: auto 1fr;
        gap: var(--size-2);
        padding: var(--padding-medium);
    }
</style>

<script>
    import { addOutputListener } from "@analogjs/astro-angular/utils";

    addOutputListener("hello-component-1", "outputName", (event) => {
        console.log(event.detail);
    });
</script>
