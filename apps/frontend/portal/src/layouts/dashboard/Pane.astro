---
// src/components/Panel.astro
const { area, class: extraClass = '' } = Astro.props;
---

<style>
    .panel {
        border-radius: var(--roundness-medium);
        border: 1px solid var(--outline-1);
        background: var(--surface-1);
        box-shadow: var(--shadow-2);
        color: var(--text-1);
        display: grid;

        grid-template-rows: auto 1fr;
        gap: var(--size-2);
        padding: var(--padding-medium);
    }

    .panel-header {
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-6);
    }

    .panel-header {
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-6);
    }

    .flair {
        border: 3px solid #ab00e9;
        background-color: #f8e8fe;
    }
    /* 
  .panel-footer {
    margin-top: auto;
    font-size: var(--font-size-1);
    color: var(--text-2);
  } */
</style>

<div class={`panel ${extraClass}`} style={`grid-area: ${area};`}>
    <header class="panel-header">
        <slot name="header" />
    </header>

    <div class="panel-content">
        <slot />
    </div>
    <!-- 
  <footer class="panel-footer">
    <slot name="footer" />
  </footer> -->
</div>
