{
    "name": "frontend-portal",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "targets": {
        "build": {
            "executor": "nx:run-script",
            "options": {
                "script": "astro build"
            }
        },
        "serve": {
            "executor": "nx:run-script",
            "options": {
                "script": "astro dev --port=3001",
                "proxyConfig": "apps/frontend/portal/proxy.conf.json"
            }
        },
        "docker-build": {
            "command": "docker build -f apps/frontend/portal/Dockerfile . -t flux-portal"
        }
    }
}
