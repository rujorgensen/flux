{
  "name": "@persistica/source",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "//-01a": "// ****************************************************************************",
    "//-01b": "// *** Docker                                                                ",
    "//-01c": "// ****************************************************************************",
    "docker:portal:e2e:up": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml up -d --build",
    "docker:portal:e2e:down": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml down",
    "docker:dev:up": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml up -d --build",
    "docker:dev:down": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml down",
    "//-02a": "// ****************************************************************************",
    "//-02b": "// *** Prisma                                                                ",
    "//-02c": "// ****************************************************************************",
    "prisma:generate:portal": "bunx prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev:portal": "bunx prisma migrate dev --schema=./prisma/schema.prisma --name=init",
    "prisma:deploy": "bunx prisma migrate deploy --schema=./prisma/schema.prisma",
    "//-03a": "// ****************************************************************************",
    "//-03b": "// *** Update                                                                ",
    "//-03c": "// ****************************************************************************",
    "upd": "bun upgrade && ncu -i --format group",
    "serve:stack:portal": "bun run run-stack",
    "//-04a": "// ****************************************************************************",
    "//-04b": "// *** Caddy                                                                ",
    "//-04c": "// ****************************************************************************",
    "caddy:config:read": "curl localhost:2019/config/",
    "caddy:config:load": "caddy adapt --config ./Caddyfile && caddy reload",
    "postinstall": "bun prisma:generate:portal || bun prisma:migrate:dev:portal || true",
    "//-06a": "// ****************************************************************************",
    "//-06b": "// *** NPM Publish                                                             ",
    "//-06c": "// ****************************************************************************",
    "publish:agent": "bunx nx run persistica-flux-agent:nx-release-publish",
    "publish:authority": "bunx nx run persistica-flux-authority:nx-release-publish",
    "publish:mesh": "bunx nx run persistica-flux-mesh:nx-release-publish",
    "//-08a": "// ****************************************************************************",
    "//-08b": "// *** Better Auth                                                             ",
    "//-08c": "// ****************************************************************************",
    "auth:generate": "npx @better-auth/cli@latest generate --config=./apps/backend/portal/src/auth.ts",
    "auth:migrate": "npx @better-auth/cli@latest migrate --config=./apps/backend/portal/src/auth.ts",
    "//-07a": "// ****************************************************************************",
    "//-07b": "// *** Deploy                                                                  ",
    "//-07c": "// ****************************************************************************",
    "deploy:portal": "bun prisma:deploy && bun run ./dist/apps/backend/portal/main.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/node": "9.4.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "3.5.1",
    "@astrojs/svelte": "^7.1.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@lucide/svelte": "^0.542.0",
    "@nx/esbuild": "21.4.1",
    "@nx/js": "21.4.1",
    "@nx/plugin": "21.4.1",
    "@prisma/client": "^6.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "astro": "5.13.3",
    "better-auth": "1.3.7",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "elysia": "1.3.20",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "^1.13.0",
    "flowbite-svelte-icons": "^3.0.0",
    "jsonwebtoken": "9.0.2",
    "madge": "^8.0.0",
    "mode-watcher": "1.1.0",
    "open-props": "^1.7.16",
    "prisma-dbml-generator": "^0.12.0",
    "redis": "^5.8.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "svelte": "^5.38.3",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.8.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@internationalized/date": "^3.9.0",
    "@melt-ui/pp": "^0.3.2",
    "@melt-ui/svelte": "^0.86.6",
    "@nx/vite": "21.4.1",
    "@nx/web": "21.4.1",
    "@nx/workspace": "21.4.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.7.8",
    "@swc/core": "~1.13.5",
    "@swc/helpers": "~0.5.17",
    "@tailwindcss/vite": "^4.1.12",
    "@testcontainers/redis": "^11.5.1",
    "@types/bun": "latest",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "bits-ui": "^2.9.4",
    "jsdom": "~26.1.0",
    "nx": "21.4.1",
    "open-cli": "^8.0.0",
    "prisma": "^6.14.0",
    "swc-loader": "0.2.6",
    "tailwindcss": "^4.1.12",
    "testcontainers": "^11.5.1",
    "tslib": "^2.8.1",
    "vite": "^7.1.3",
    "vite-plugin-dts": "~4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.21",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "apps/demo/*"
  ]
}