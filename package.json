{
    "name": "@persistica/source",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "//-01a": "// ****************************************************************************",
        "//-01b": "// *** Docker                                                                ",
        "//-01c": "// ****************************************************************************",
        "docker:portal:e2e:up": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml up -d --build",
        "docker:portal:e2e:down": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml down",
        "docker:dev:up": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml up -d --build",
        "docker:dev:down": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml down",
        "start:self-hosted:dev": "docker compose --env-file .env -f 'docker-compose.portal.prod.yml' -f '.deploy/docker-compose.dev.yml' up -d --build",
        "//-02a": "// ****************************************************************************",
        "//-02b": "// *** Prisma                                                                ",
        "//-02c": "// ****************************************************************************",
        "prisma:generate:portal": "rm -rf ./@prisma-types && bunx --bun prisma generate --config=./prisma/prisma.config.ts",
        "prisma:migrate:dev:portal": "bunx --bun prisma migrate dev --config=./prisma/prisma.config.ts --name=add-network-subscription-type",
        "prisma:deploy": "bunx --bun prisma migrate deploy --config=./prisma/prisma.config.ts",
        "prisma:studio": "bunx --bun prisma studio --config=./prisma/prisma.config.ts",
        "prisma:seed:portal": "bunx --bun prisma db seed --config=./prisma/prisma.config.ts",
        "//-03a": "// ****************************************************************************",
        "//-03b": "// *** Update                                                                ",
        "//-03c": "// ****************************************************************************",
        "bupd": "bun upgrade && bun update --interactive --recursive --save",
        "//-04a": "// ****************************************************************************",
        "//-04b": "// *** Caddy                                                                ",
        "//-04c": "// ****************************************************************************",
        "caddy:config:read": "curl localhost:2019/config/",
        "caddy:config:load": "caddy adapt --config ./Caddyfile && caddy reload",
        "postinstall": "(bun prisma:generate:portal || true) && (bun prisma:migrate:dev:portal || true)",
        "//-06a": "// ****************************************************************************",
        "//-06b": "// *** NPM Publish                                                             ",
        "//-06c": "// ****************************************************************************",
        "publish:agent": "bunx nx run persistica-flux-agent:nx-release-publish",
        "publish:authority": "bunx nx run persistica-flux-authority:nx-release-publish",
        "publish:mesh": "bunx nx run persistica-flux-mesh:nx-release-publish",
        "//-07a": "// ****************************************************************************",
        "//-07b": "// *** Better Auth                                                             ",
        "//-07c": "// ****************************************************************************",
        "auth:generate": "npx @better-auth/cli@latest generate --config=./apps/backend/portal/src/auth.ts",
        "auth:migrate": "npx @better-auth/cli@latest migrate --config=./apps/backend/portal/src/auth.ts",
        "//-08a": "// ****************************************************************************",
        "//-08b": "// *** Development                                                             ",
        "//-08c": "// ****************************************************************************",
        "link:agent": "nx run persistica-flux-agent:link",
        "link:authority": "nx run persistica-flux-authority:link",
        "link:mesh": "nx run persistica-flux-mesh:link",
        "link:all": "echo 'links all packages for local use' && bun run link:agent && bun run link:authority && bun run link:mesh",
        "dev": "nx run @flux/portal-ui:serve",
        "//-09a": "// ****************************************************************************",
        "//-09b": "// *** Deploy                                                                  ",
        "//-09c": "// ****************************************************************************",
        "deploy:portal": "bun prisma:deploy && bun run ./dist/apps/backend/portal/main.js"
    },
    "dependencies": {
        "@angular/common": "21.2.10",
        "@angular/compiler": "21.2.10",
        "@angular/core": "21.2.10",
        "@angular/forms": "21.2.10",
        "@angular/platform-browser": "21.2.10",
        "@angular/router": "21.2.10",
