{
    "name": "@persistica/source",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "//-01a": "// ****************************************************************************",
        "//-01b": "// *** Docker                                                                ",
        "//-01c": "// ****************************************************************************",
        "docker:portal:e2e:up": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml up -d --build",
        "docker:portal:e2e:down": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml down",
        "docker:dev:up": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml up -d --build",
        "docker:dev:down": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml down",
        "//-02a": "// ****************************************************************************",
        "//-02b": "// *** Prisma                                                                ",
        "//-02c": "// ****************************************************************************",
        "prisma:generate:portal": "bunx prisma generate --schema=./prisma/schema.prisma",
        "prisma:migrate:dev:portal": "bunx prisma migrate dev --schema=./prisma/schema.prisma --name=init",
        "prisma:deploy": "bunx prisma migrate deploy --schema=./prisma/schema.prisma",
        "prisma:studio": "bunx prisma studio",
        "//-03a": "// ****************************************************************************",
        "//-03b": "// *** Update                                                                ",
        "//-03c": "// ****************************************************************************",
        "upd": "bun upgrade && ncu -i --format group",
        "serve:stack:portal": "bun run run-stack",
        "//-04a": "// ****************************************************************************",
        "//-04b": "// *** Caddy                                                                ",
        "//-04c": "// ****************************************************************************",
        "caddy:config:read": "curl localhost:2019/config/",
        "caddy:config:load": "caddy adapt --config ./Caddyfile && caddy reload",
        "postinstall": "bun prisma:generate:portal || bun prisma:migrate:dev:portal || true",
        "//-06a": "// ****************************************************************************",
        "//-06b": "// *** NPM Publish                                                             ",
        "//-06c": "// ****************************************************************************",
        "publish:agent": "bunx nx run persistica-flux-agent:nx-release-publish",
        "publish:authority": "bunx nx run persistica-flux-authority:nx-release-publish",
        "publish:mesh": "bunx nx run persistica-flux-mesh:nx-release-publish",
        "//-07a": "// ****************************************************************************",
        "//-07b": "// *** Better Auth                                                             ",
        "//-07c": "// ****************************************************************************",
        "auth:generate": "npx @better-auth/cli@latest generate --config=./apps/backend/portal/src/auth.ts",
        "auth:migrate": "npx @better-auth/cli@latest migrate --config=./apps/backend/portal/src/auth.ts",
        "//-08a": "// ****************************************************************************",
        "//-08b": "// *** Development                                                             ",
        "//-08c": "// ****************************************************************************",
        "link:agent": "nx run persistica-flux-agent:link",
        "link:authority": "nx run persistica-flux-authority:link",
        "link:mesh": "nx run persistica-flux-mesh:link",
        "link:all": "echo 'links all packages for local use' && bun run link:agent && bun run link:authority && bun run link:mesh",
        "//-09a": "// ****************************************************************************",
        "//-09b": "// *** Deploy                                                                  ",
        "//-09c": "// ****************************************************************************",
        "deploy:portal": "bun prisma:deploy && bun run ./dist/apps/backend/portal/main.js"
    },
    "dependencies": {
        "@analogjs/astro-angular": "^2.1.2",
        "@angular/animations": "^21.0.2",
        "@angular/build": "^21.0.1",
        "@angular/common": "^21.0.2",
        "@angular/compiler": "^21.0.2",
        "@angular/compiler-cli": "^21.0.2",
        "@angular/core": "^21.0.2",
        "@angular/forms": "^21.0.2",
        "@angular/language-service": "^21.0.2",
        "@angular/platform-browser": "^21.0.2",
        "@angular/platform-server": "^21.0.2",
        "@astrojs/mdx": "^4.3.12",
        "@astrojs/node": "9.5.1",
        "@astrojs/rss": "^4.0.14",
        "@astrojs/sitemap": "3.6.0",
        "@astrojs/svelte": "^7.2.2",
        "@elysiajs/cors": "^1.4.0",
        "@elysiajs/eden": "^1.4.5",
        "@elysiajs/swagger": "^1.3.1",
        "@lucide/svelte": "^0.555.0",
        "@nx/esbuild": "22.1.3",
        "@nx/js": "22.1.3",
        "@nx/plugin": "22.1.3",
        "@prisma/client": "^6.19.0",
        "@tailwindcss/postcss": "^4.1.17",
        "@types/jsonwebtoken": "^9.0.10",
        "astro": "5.16.3",
        "better-auth": "1.4.4",
        "chart.js": "^4.5.1",
        "clsx": "^2.1.1",
        "daisyui": "^5.5.5",
        "elysia": "1.4.17",
        "flowbite": "^4.0.1",
        "flowbite-svelte": "^1.29.1",
        "flowbite-svelte-icons": "^3.0.0",
        "jsonwebtoken": "9.0.2",
        "madge": "^8.0.0",
        "mode-watcher": "1.1.0",
        "nanoid": "^5.1.6",
        "open-props": "^1.7.17",
        "postcss": "^8.5.6",
        "prisma-dbml-generator": "^0.12.0",
        "redis": "^5.10.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "rxjs": "^7.8.2",
        "svelte": "^5.45.3",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "webpack-bundle-analyzer": "^5.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@internationalized/date": "^3.10.0",
        "@melt-ui/pp": "^0.3.2",
        "@melt-ui/svelte": "^0.86.6",
        "@nx/vite": "22.1.3",
        "@nx/web": "22.1.3",
        "@nx/workspace": "22.1.3",
        "@tailwindcss/vite": "^4.1.17",
        "@testcontainers/redis": "^11.9.0",
        "@types/bun": "1.3.3",
        "@types/node": "24.10.1",
        "@vitest/coverage-v8": "^4.0.14",
        "@vitest/ui": "^4.0.14",
        "bits-ui": "^2.14.4",
        "jsdom": "~27.2.0",
        "nx": "22.1.3",
        "open-cli": "^8.0.0",
        "prisma": "^6.19.0",
        "tailwindcss": "^4.1.17",
        "testcontainers": "^11.9.0",
        "tslib": "^2.8.1",
        "vite": "^7.2.6",
        "vite-plugin-dts": "~4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.0.14"
    },
    "packageManager": "bun@1.3.3",
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "workspaces": [
        "apps/demo/*"
    ]
}