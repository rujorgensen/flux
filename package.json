{
    "name": "@proper-proxima/source",
    "type": "module",
    "version": "0.0.0",
    "scripts": {
        "//-01a": "// ****************************************************************************",
        "//-01b": "// *** Docker                                                                ",
        "//-01c": "// ****************************************************************************",
        "docker:portal:e2e:up": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml up -d --build",
        "docker:portal:e2e:down": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml down",
        "docker:dev:up": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml up -d --build",
        "docker:dev:down": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml down",
        "//-02a": "// ****************************************************************************",
        "//-02b": "// *** Prisma                                                                ",
        "//-02c": "// ****************************************************************************",
        "prisma:migrate:dev:portal": "bunx prisma migrate dev --schema=./prisma/schema.prisma",
        "prisma:generate:portal": "bunx prisma generate --schema=./prisma/schema.prisma",
        "prisma:deploy": "bunx prisma migrate deploy --schema=./prisma/schema.prisma",
        "//-03a": "// ****************************************************************************",
        "//-03b": "// *** Update                                                                ",
        "//-03c": "// ****************************************************************************",
        "upd": "ncu -i --format group",
        "serve:stack:portal": "bun run run-stack",
        "prisma:migrate": "bunx prisma migrate dev --name init",
        "//-04a": "// ****************************************************************************",
        "//-04b": "// *** Caddy                                                                ",
        "//-04c": "// ****************************************************************************",
        "caddy:config:read": "curl localhost:2019/config/",
        "caddy:config:load": "caddy adapt --config ./Caddyfile && caddy reload",
        "postinstall": "bun prisma:generate:portal || true",
        "//-07a": "// ****************************************************************************",
        "//-07b": "// *** Deploy                                                                  ",
        "//-07c": "// ****************************************************************************",
        "deploy:portal": "bun prisma:deploy && bun run ./dist/apps/backend/portal/main.js"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.0",
        "@astrojs/node": "^9.2.2",
        "@astrojs/rss": "^4.0.12",
        "@astrojs/sitemap": "^3.4.1",
        "@astrojs/svelte": "^7.1.0",
        "@elysiajs/cors": "^1.3.3",
        "@elysiajs/eden": "^1.3.2",
        "@elysiajs/jwt": "^1.3.1",
        "@elysiajs/swagger": "^1.3.0",
        "@lucide/svelte": "^0.513.0",
        "@nx/js": "21.1.3",
        "@nx/plugin": "21.1.3",
        "@prisma/client": "^6.9.0",
        "@types/jsonwebtoken": "^9.0.9",
        "astro": "^5.9.2",
        "chart.js": "^4.4.9",
        "elysia": "1.3.4",
        "flowbite": "^3.1.2",
        "flowbite-svelte": "^1.6.1",
        "flowbite-svelte-icons": "^2.2.0",
        "jsonwebtoken": "9.0.2",
        "madge": "^8.0.0",
        "open-props": "^1.7.15",
        "redis": "^5.1.1",
        "rollup-plugin-visualizer": "^6.0.3",
        "svelte": "^5.33.18",
        "typescript": "^5.8.3",
        "webpack-bundle-analyzer": "^4.10.2"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@melt-ui/pp": "^0.3.2",
        "@melt-ui/svelte": "^0.86.6",
        "@nx/vite": "21.1.3",
        "@nx/web": "21.1.3",
        "@nx/workspace": "21.1.3",
        "@swc-node/register": "~1.10.10",
        "@swc/cli": "~0.7.7",
        "@swc/core": "~1.11.31",
        "@swc/helpers": "~0.5.17",
        "@testcontainers/redis": "^11.0.2",
        "@types/bun": "latest",
        "@types/node": "24.0.0",
        "@vitest/coverage-v8": "^3.2.3",
        "@vitest/ui": "^3.2.3",
        "jsdom": "~26.1.0",
        "nx": "21.1.3",
        "open-cli": "^8.0.0",
        "prisma": "^6.9.0",
        "swc-loader": "0.2.6",
        "testcontainers": "^11.0.2",
        "tslib": "^2.8.1",
        "vite": "^6.3.5",
        "vite-plugin-dts": "~4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.3"
    },
    "packageManager": "bun@1.2.15",
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "workspaces": [
        "apps/demo/*"
    ]
}