{
    "name": "@persistica/source",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "//-01a": "// ****************************************************************************",
        "//-01b": "// *** Docker                                                                ",
        "//-01c": "// ****************************************************************************",
        "docker:portal:e2e:up": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml up -d --build",
        "docker:portal:e2e:down": "docker compose -p flux-portal -f .deploy/docker-compose.e2e.yml down",
        "docker:dev:up": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml up -d --build",
        "docker:dev:down": "docker compose -p flux-dev -f .deploy/docker-compose.dev.yml down",
        "start:self-hosted:dev": "docker compose --env-file .env -f 'docker-compose.portal.prod.yml' -f '.deploy/docker-compose.dev.yml' up -d --build",
        "//-02a": "// ****************************************************************************",
        "//-02b": "// *** Prisma                                                                ",
        "//-02c": "// ****************************************************************************",
        "prisma:generate:portal": "rm -rf ./@prisma-types && bunx --bun prisma generate --config=./prisma/prisma.config.ts",
        "prisma:migrate:dev:portal": "bunx --bun prisma migrate dev --config=./prisma/prisma.config.ts --name=init",
        "prisma:deploy": "bunx --bun prisma migrate deploy --config=./prisma/prisma.config.ts",
        "prisma:studio": "bunx --bun prisma studio --config=./prisma/prisma.config.ts",
        "//-03a": "// ****************************************************************************",
        "//-03b": "// *** Update                                                                ",
        "//-03c": "// ****************************************************************************",
        "bupd": "bun upgrade && bun update --interactive --recursive --save",
        "serve:portal-ui": "nx serve @flux/portal-ui",
        "serve:portal-api": "nx serve @flux/portal-api",
        "serve:stack:portal": "bun run --parallel serve:portal-ui serve:portal-api",
        "//-04a": "// ****************************************************************************",
        "//-04b": "// *** Caddy                                                                ",
        "//-04c": "// ****************************************************************************",
        "caddy:config:read": "curl localhost:2019/config/",
        "caddy:config:load": "caddy adapt --config ./Caddyfile && caddy reload",
        "postinstall": "bun prisma:generate:portal || bun prisma:migrate:dev:portal || true",
        "//-06a": "// ****************************************************************************",
        "//-06b": "// *** NPM Publish                                                             ",
        "//-06c": "// ****************************************************************************",
        "publish:agent": "bunx nx run persistica-flux-agent:nx-release-publish",
        "publish:authority": "bunx nx run persistica-flux-authority:nx-release-publish",
        "publish:mesh": "bunx nx run persistica-flux-mesh:nx-release-publish",
        "//-07a": "// ****************************************************************************",
        "//-07b": "// *** Better Auth                                                             ",
        "//-07c": "// ****************************************************************************",
        "auth:generate": "npx @better-auth/cli@latest generate --config=./apps/backend/portal/src/auth.ts",
        "auth:migrate": "npx @better-auth/cli@latest migrate --config=./apps/backend/portal/src/auth.ts",
        "//-08a": "// ****************************************************************************",
        "//-08b": "// *** Development                                                             ",
        "//-08c": "// ****************************************************************************",
        "link:agent": "nx run persistica-flux-agent:link",
        "link:authority": "nx run persistica-flux-authority:link",
        "link:mesh": "nx run persistica-flux-mesh:link",
        "link:all": "echo 'links all packages for local use' && bun run link:agent && bun run link:authority && bun run link:mesh",
        "dev": "nx run @flux/portal-ui:serve",
        "//-09a": "// ****************************************************************************",
        "//-09b": "// *** Deploy                                                                  ",
        "//-09c": "// ****************************************************************************",
        "deploy:portal": "bun prisma:deploy && bun run ./dist/apps/backend/portal/main.js"
    },
    "dependencies": {
        "@nx/esbuild": "22.5.0",
        "@nx/js": "22.5.0",
        "@nx/plugin": "22.5.0",
        "clsx": "^2.1.1",
        "jsonwebtoken": "catalog:",
        "nanoid": "catalog:",
        "rxjs": "^7.8.2",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.2",
        "@nx/vite": "22.5.0",
        "@nx/web": "22.5.0",
        "@nx/workspace": "22.5.0",
        "@testcontainers/redis": "^11.10.0",
        "@types/bun": "1.3.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "25.2.3",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "jsdom": "~28.0.0",
        "nx": "22.5.0",
        "open-cli": "^8.0.0",
        "testcontainers": "^11.10.0",
        "tslib": "^2.8.1",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "^4.0.18"
    },
    "packageManager": "bun@1.3.9",
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "workspaces": {
        "packages": [
            "apps/**"
        ],
        "catalog": {
            "@tailwindcss/vite": "^4.1.18",
            "@tailwindcss/postcss": "^4.1.18",
            "better-auth": "1.4.18",
            "bits-ui": "^2.15.5",
            "chart.js": "^4.5.1",
            "daisyui": "^5.5.18",
            "nanoid": "^5.1.6",
            "tailwind-merge": "^3.4.0",
            "tailwind-variants": "^3.2.2",
            "tw-animate-css": "^1.4.0",
            "tailwindcss": "^4.1.18",
            "postcss": "^8.5.6",
            "jsonwebtoken": "9.0.3",
            "open-props": "^1.7.23",
            "rollup-plugin-visualizer": "^6.0.5",
            "webpack-bundle-analyzer": "^5.0.1",
            "vite-tsconfig-paths": "^6.1.0",
            "vite": "^7.3.1",
            "vite-plugin-dts": "~4.5.4",
            "zod": "^4.3.6"
        },
        "catalogs": {
            "prisma": {
                "@prisma/client": "7.4.0",
                "@prisma/adapter-pg": "7.4.0",
                "prisma": "7.4.0"
            },
            "elysia": {
                "@elysiajs/cors": "^1.4.1",
                "@elysiajs/eden": "^1.4.8",
                "@elysiajs/swagger": "^1.3.1",
                "elysia": "1.4.25"
            },
            "angular": {
                "@analogjs/astro-angular": "^2.2.3",
                "@angular/animations": "^21.1.3",
                "@angular/build": "^21.1.3",
                "@angular/common": "^21.1.3",
                "@angular/compiler": "^21.1.3",
                "@angular/compiler-cli": "^21.1.3",
                "@angular/core": "^21.1.3",
                "@angular/forms": "^21.1.3",
                "@angular/language-service": "^21.1.3",
                "@angular/platform-browser": "^21.1.3",
                "@angular/platform-server": "^21.1.3"
            },
            "astro": {
                "@astrojs/mdx": "^4.3.13",
                "@astrojs/node": "9.5.2",
                "@astrojs/rss": "^4.0.15",
                "@astrojs/sitemap": "3.7.0",
                "astro": "5.17.2"
            }
        }
    }
}