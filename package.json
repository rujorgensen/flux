        "@elysiajs/cors": "^1.3.0",
        "@elysiajs/eden": "^1.3.2",
        "@elysiajs/jwt": "^1.3.0",
        "@elysiajs/swagger": "^1.3.0",
        "@lucide/svelte": "^0.507.0",
        "@nx/js": "21.0.0",
        "@nx/plugin": "21.0.0",
        "@prisma/client": "^6.7.0",
        "@types/jsonwebtoken": "^9.0.9",
        "astro": "^5.7.11",
        "chart.js": "^4.4.9",
        "elysia": "latest",
        "flowbite": "^3.1.2",
        "flowbite-svelte": "^1.0.2",
        "flowbite-svelte-icons": "^2.1.1",
        "jsonwebtoken": "9.0.2",
        "madge": "^8.0.0",
