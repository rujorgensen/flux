{
    "name": "flux-shared-types",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/flux/shared/types/src",
    "projectType": "library",
    "targets": {
        "lint": {
            "executor": "nx-oxlint:lint"
        },
        "build": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/libs/flux/shared/types",
                "main": "libs/flux/shared/types/src/index.ts",
                "tsConfig": "libs/flux/shared/types/tsconfig.lib.json",
                "assets": []
            }
        },
        "bun-test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun test {projectRoot}/ --env-file=.env.e2e"
            }
        }
    },
    "tags": [
        "type:type",
        "scope:shared"
    ]
}