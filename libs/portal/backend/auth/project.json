{
    "name": "backend-portal-auth",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/portal/backend/auth/src",
    "projectType": "library",
    "tags": [
        "type:auth",
        "scope:backend"
    ],
    "// targets": "to see all targets run: nx show project backend-portal-auth --web",
    "targets": {
        "lint": {
            "executor": "nx-oxlint:lint"
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun build {projectRoot}/src/index.ts",
                "args": [
                    "--outdir=dist/{projectRoot}",
                    "--target=bun",
                    "--format=esm",
                    "--minify"
                ]
            }
        }
    }
}