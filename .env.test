FLUX_MESH_REDIS_URL=redis://localhost:1000 # Does not exist
# Never connected to: the portal specs only need the module to load, and Prisma
# connects lazily. Pointing at a real database here would let a test silently
# talk to it.
FLUX_DATABASE_URL=postgres://test-user:test-password@localhost:1002/test-db?schema=public # Does not exist
# FLUX_MESH_JWT_KEY=flux-jwt-mesh-key
FLUX_AUTHORITY_JWT_SECRET=flux-authority-jwt-secret
FLUX_PORTAL_REDIS_URL=redis://localhost:1001 # Does not exist

# Better Auth
GOOGLE_CLIENT_ID=test-client-id-123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOOGLE-CLIENT-SECRET-TEST