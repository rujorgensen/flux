{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2022",
        "module": "esnext",
        "lib": [
            "ES2022",
            "dom"
        ],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "paths": {
            "$lib/*": [
                "./apps/frontend/portal/src/*"
            ],
            "@backend/portal/auth": [
                "./libs/portal/backend/auth/src/index.ts"
            ],
            "@backend/features/network": [
                "./libs/backend/features/network/src/index.ts"
            ],
            "@backend/core/prisma": [
                "./libs/backend/core/prisma/src/index.ts"
            ],
            "@core/redis/bun": [
                "./libs/core/redis/bun-wrapper/src/index.ts"
            ],
            "@flux/mesh": [
                "./packages/flux/mesh/src/index.ts"
            ],
            "@flux/mesh/core/redis": [
                "./libs/flux/mesh/core/redis/src/index.ts"
            ],
            "@flux/mesh/store/redis/network-agent": [
                "./libs/flux/mesh/store/redis/network-agent/src/index.ts"
            ],
            "@flux/mesh/store/redis/network-authority": [
                "./libs/flux/mesh/store/redis/network-authority/src/index.ts"
            ],
            "@flux/mesh/store/redis/network-channel": [
                "./libs/flux/mesh/store/redis/network-channel/src/index.ts"
            ],
            "@flux/mesh/store/redis/network-usage": [
                "./libs/flux/mesh/store/redis/network-usage/src/index.ts"
            ],
            "@flux/mesh/test/setup/infrastructure": [
                "./libs/flux/mesh/test/setup/infrastructure/src/index.ts"
            ],
            "@flux/portal/core/redis": [
                "./libs/flux/portal/core/redis/src/index.ts"
            ],
            "@flux/shared/connection": [
                "./libs/flux/shared/connection/src/index.ts"
            ],
            "@flux/shared/types": [
                "./libs/flux/shared/types/src/index.ts"
            ],
            "@flux/shared/features/networks": [
                "./libs/shared/features/networks/src/index.ts"
            ],
            "@flux/shared/utils": [
                "./libs/flux/shared/utils/src/index.ts"
            ],
            "@flux/shared/ws": [
                "./libs/flux/shared/ws/src/index.ts"
            ],
            "@persistica/flux-agent": [
                "./packages/flux/agent/src/index.ts"
            ],
            "@persistica/flux-authority": [
                "./packages/flux/authority/src/index.ts"
            ],
            "@persistica/mesh": [
                "./packages/flux/mesh/src/index.ts"
            ],
            "@utils/pico-logger": [
                "./libs/utils/logger/src/index.ts"
            ],
            "@prisma-types/flux": [
                "./@prisma-types/flux/client.ts"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "tmp"
    ]
}