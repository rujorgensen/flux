generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/@prisma-types/flux"
}

datasource db {
    provider = "postgresql"
    url      = env("FLUX_DATABASE_URL")
}

// ****************************************************************************
// *** User
// ****************************************************************************
model User {
    id                   String        @id @default(nanoid())
    email                String        @unique
    magicLink            String?       @unique
    magicLinkExpiryAt    DateTime?
    magicLinkRequestedAt DateTime?
    userSessions         UserSession[]
    userNetworks         UserNetwork[]
}

model UserSession {
    id                 String         @id @default(nanoid())
    userId             String
    user               User           @relation(fields: [userId], references: [id])
    createdAt          DateTime       @default(now())
    ip                 String
    userAgent          String
    loginAuthenticator String
    authenticator      EAuthenticator
}

model Network {
    id           String        @id @default(nanoid())
    alias        String
    secretKey    String        @unique
    updatedAt    DateTime      @default(now())
    createdAt    DateTime      @default(now())
    userNetworks UserNetwork[]
}

model UserNetwork {
    id        String           @id @default(nanoid())
    userId    String
    user      User             @relation(fields: [userId], references: [id])
    role      EUserNetworkRole
    networkId String
    network   Network          @relation(fields: [networkId], references: [id])
}

// ****************************************************************************
// *** Stats
// ****************************************************************************

model UsageHistory {
    id         String   @id @default(nanoid())
    networkId  String   @unique
    usageKb    Int
    timeslotAt DateTime @default(now())
}

model ConnectedAuthoritiesHistory {
    id         String   @id @default(nanoid())
    networkId  String   @unique
    count      Int
    timeslotAt DateTime @default(now())
}

model ConnectedAgentsHistory {
    id         String   @id @default(nanoid())
    networkId  String   @unique
    count      Int
    timeslotAt DateTime @default(now())
}

model ChannelsHistory {
    id         String   @id @default(nanoid())
    networkId  String   @unique
    count      Int
    timeslotAt DateTime @default(now())
}

enum EAuthenticator {
    USERNAME_PASSWORD
    MAGIC_LINK
    GOOGLE
    FACEBOOK
}

enum EUserNetworkRole {
    USER
    ADMIN
}
